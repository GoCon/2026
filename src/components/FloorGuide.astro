---
import { Image } from "astro:assets";
import FloorMapPcImage from "../assets/map/floor_map_pc.png";
import FloorMapSpImage from "../assets/map/floor_map_sp.png";

interface Props {
  lang?: "ja" | "en";
}
const { lang = "ja" } = Astro.props;
const altText = lang === "en" ? "Floor Map" : "フロアマップ";
---

<div class="floor-map-wrapper">
  <Image
    src={FloorMapPcImage}
    alt={altText}
    sizes="80vw"
    priority
    class="floor-map pc-only"
  />
  <Image
    src={FloorMapSpImage}
    alt={altText}
    priority
    class="floor-map sp-only"
  />
</div>

<style>
  .pc-only {
    display: block;
  }
  .sp-only {
    display: none;
  }

  .floor-map-wrapper {
    display: flex;
    justify-content: center;
  }
  .floor-map {
    width: 100%;
    max-width: 768px;
    max-width: 100%;
    height: auto;
  }

  @media screen and (max-width: 768px) {
    .pc-only {
      display: none;
    }
    .sp-only {
      display: block;
    }

    .floor-map-wrapper {
      padding: 16px 0;
    }
  }
</style>
