---
const currentLocale = Astro.currentLocale || "ja";
const isJa = currentLocale === "ja";
---

<section id="conference-ended">
  <p class="text-section-title">
    <span class="accent">Go Conference 2026</span>
    {isJa ? "は終了いたしました" : " has ended."}
  </p>
  <p class="text-body-large">
    {
      isJa
        ? "ご登壇、ご参加、ご協力いただいたスポンサー、運営の皆さんありがとうございました！"
        : "Thank you to all speakers, attendees, sponsors, and organizers!"
    }
  </p>
</section>

<style>
  section#conference-ended {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-m);
    padding-top: var(--space-l);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    text-align: center;
  }

  #conference-ended p {
    margin: 0;
  }

  .accent {
    color: var(--text-accent);
  }
</style>
