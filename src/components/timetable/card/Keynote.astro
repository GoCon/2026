---
import type { ProgramKeynote } from "../program";
import { getProgramTimeString } from "../programTime";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  program: Extract<ProgramKeynote, { type: "keynote" }>;
};

const { program } = Astro.props as Props;
const currentLocale = Astro.currentLocale || "ja";
const timeString = getProgramTimeString(program);
const isPlaceholder = program.isPlaceholder === true;
const placeholderTitle = currentLocale === "ja" ? "基調講演" : "Keynote";
---

<div
  class="card card--keynote"
  class:list={[{ "card--placeholder": isPlaceholder }]}
>
  <div class="metadata-container text-body-medium-strong">
    <div class="time-container">
      <span>{timeString}</span>
    </div>
  </div>
  {
    isPlaceholder ? (
      <div class="title-container title-container--placeholder text-body-large-strong">
        <span>{placeholderTitle}</span>
      </div>
    ) : (
      <a
        class="title-container text-body-large-strong"
        href={getRelativeLocaleUrl(currentLocale, `timetable/${program.id}`)}
      >
        <div class="text-wrapper">
          <span>{program.title}</span>
        </div>
      </a>
    )
  }
  <div class="footer-container">
    {
      !isPlaceholder && (
        <div class="speaker-container">
          <img class="icon" src={program.speaker.avatar} alt="" />
          <span class="text-body-small-strong">{program.speaker.name}</span>
        </div>
      )
    }
    <span class="text-body-small">Keynote(40min)</span>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxxs);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-objects);
    background-color: var(--surface-session-light);
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .card .metadata-container {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .card .metadata-container .time-container {
    flex: 1;
  }

  .card .title-container {
    color: var(--text-primary);
    transition: color 0.1s ease-in-out;
    display: flex;
    overflow: hidden;
    align-items: center;
    height: 56px;
    flex-shrink: 0;
  }

  .card .title-container:hover {
    color: var(--text-accent);
  }

  .card .title-container .text-wrapper {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    height: fit-content;
  }

  .card .title-container span {
    margin: auto 0;
    height: fit-content;
  }

  .card .title-container--placeholder {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    height: 56px;
  }

  .card--placeholder .footer-container {
    justify-content: flex-end;
  }

  .card .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .card .footer-container .speaker-container {
    display: flex;
    gap: var(--space-xxxs);
  }

  .card .footer-container .speaker-container .icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .card.card--keynote {
      height: auto;
      min-height: 300px;
      overflow: visible;
    }
  }

  @media screen and (max-width: 375px) {
    .card .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xxxs);
    }
  }
</style>
