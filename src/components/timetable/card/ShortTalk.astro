---
import type { ProgramShortTalk } from "../program";
import DifficultyBadge from "../DifficultyBadge.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  program: Extract<ProgramShortTalk, { type: "shortTalk" }>;
};

const { program } = Astro.props as Props;
const currentLocale = Astro.currentLocale || "ja";
---

<div class="card">
  <div class="metadata-container text-body-medium-strong">
    <div class="time-container">
      <span>{program.timeString}</span>
    </div>
    <DifficultyBadge difficulty={program.difficulty} />
  </div>
  <a
    class="title-container text-body-large-strong"
    href={getRelativeLocaleUrl(currentLocale, `timetable/${program.id}`)}
    class="text-body-large-strong"
  >
    <div class="text-wrapper">
      <span>{program.title}</span>
    </div>
  </a>
  <div class="footer-container">
    <div class="speaker-container">
      <img class="icon" src={program.speaker.avatar} />
      <span class="text-body-small-strong">{program.speaker.name}</span>
    </div>
    <span class="text-body-small">Short Talk(20min)</span>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxxs);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-objects);
    background-color: var(--surface-session-light);
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .card .metadata-container {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .card .metadata-container .time-container {
    flex: 1;
  }

  .card .title-container {
    color: var(--text-primary);
    transition: color 0.1s ease-in-out;
    display: flex;
    overflow: hidden;
    align-items: center;
    height: 56px;
    flex-shrink: 0;
  }

  .card .title-container:hover {
    color: var(--text-accent);
  }

  .card .title-container .text-wrapper {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    height: fit-content;
  }

  .card .title-container span {
    margin: auto 0;
    height: fit-content;
  }

  .card .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: auto;
  }

  .card .footer-container .speaker-container {
    display: flex;
    gap: var(--space-xxxs);
  }

  .card .footer-container .speaker-container .icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .card {
      height: auto;
      min-height: 150px;
      overflow: visible;
    }
  }

  @media screen and (max-width: 375px) {
    .card .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xxxs);
    }
  }
</style>
