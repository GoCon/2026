---
import { getRelativeLocaleUrl } from "astro:i18n";
import { constants } from "../../../constants";
import SubPage from "../../../layouts/SubPage.astro";
import { getProgramOgImagePublicPath } from "../../../utils/generateOgImage";
import BackLink from "../../ui/BackLink.astro";
import Button from "../../ui/Button.astro";
import SectionTitle from "../../ui/SectionTitle.astro";
import DifficultyBadge from "../DifficultyBadge.astro";
import type { ProgramSession } from "./programDetail";
import { getProgramRoom, type ProgramRoom } from "../programRoom";
import { getWorkshopConnpassUrl } from "../workshopConnpass";
import RoomIcon from "../../../assets/icons/room.svg";
import XLogo from "../../../assets/icons/x.svg";

interface Props {
  program: ProgramSession;
}

const { program } = Astro.props;
const { type } = program;
const currentLocale = Astro.currentLocale || "ja";

const sectionTitle = currentLocale === "ja" ? "タイムテーブル" : "Timetable";
const backLinkText =
  currentLocale === "ja" ? "タイムテーブルに戻る" : "Back to Timetable";

function getSessionTypeLabel(
  sessionProgram: ProgramSession,
  locale: string,
): string {
  switch (sessionProgram.type) {
    case "longSession":
      return "Long Session(40min)";
    case "shortTalk":
      return "Short Talk(20min)";
    case "sponsorSession":
      return locale === "ja"
        ? "ランチ・ドリンクセッション(15min)"
        : "Lunch & Drink Session(15min)";
    case "keynote":
      return "Keynote(40min)";
    case "workshop":
      return `Workshop(${sessionProgram.duration})`;
  }
}

function getRoomLabel(room: ProgramRoom, type: ProgramSession["type"]): string {
  const isWorkshop = type === "workshop";
  if (isWorkshop) {
    return room === "roomA" ? "WorkshopA" : "WorkshopB";
  }
  return room === "roomA" ? "RoomA" : "RoomB";
}

const sessionTypeLabel = getSessionTypeLabel(program, currentLocale);
const room = getProgramRoom(program.id);
const roomLabel = getRoomLabel(room, type);

const timetableParams = new URLSearchParams({
  tab: type === "workshop" ? "workshop" : "session",
  room: room === "roomB" ? "b" : "a",
});
const timetableUrl = `${getRelativeLocaleUrl(currentLocale, "timetable")}?${timetableParams.toString()}`;
const description =
  program.description ??
  `${program.title} - ${sectionTitle} | ${constants.pageTitle}`;
const connpassUrl =
  type === "workshop" ? getWorkshopConnpassUrl(program.id) : undefined;
const registerLabel =
  currentLocale === "ja" ? "このワークショップに参加" : "Join this workshop";
const shareLabel = currentLocale === "ja" ? "Xでシェア" : "Share on X";
const shareUrl = `https://x.com/intent/post?${new URLSearchParams({
  text: `\n\n`,
  url: Astro.url.href,
  hashtags: "gocon26",
}).toString()}`;
---

<SubPage
  pageTitleJa="タイムテーブル"
  pageTitleEn="Timetable"
  documentTitle={`${program.title} - ${sectionTitle} | ${constants.pageTitle}`}
  description={description}
  ogImage={getProgramOgImagePublicPath(program.id)}
  ogType="article"
  twitterCard="summary_large_image"
>
  <div class:list={["detail", { "detail--with-fab": connpassUrl }]}>
    <div class="detail-body">
      <div class="header">
        <BackLink href={timetableUrl} text={backLinkText} />
        <SectionTitle>
          <span class="section-title">{program.title}</span>
        </SectionTitle>
        <div class="metadata text-body-large-strong">
          <div class="badges">
            <div class:list={["room-badge", `room-badge--${type}`]}>
              <RoomIcon class="room-icon" />
              <span>{roomLabel}</span>
            </div>
            {
              type === "sponsorSession" && (
                <div class="sponsored-session-badge">
                  <span>Sponsored Session</span>
                </div>
              )
            }
            {
              type !== "keynote" && program.difficulty && (
                <DifficultyBadge
                  difficulty={program.difficulty}
                  variant="detail"
                />
              )
            }
          </div>
          <div class="session-type-label">
            <span class="text-body-large-strong">{sessionTypeLabel}</span>
          </div>
        </div>
      </div>

      <section id="content">
        <div class="description">{program.description}</div>
      </section>

      <section id="speaker">
        <div class="speaker-info">
          <div class="speaker-info-name">
            <img
              class="speaker-avatar"
              src={program.speaker.avatar}
              alt={program.speaker.name}
            />
            <span class="text-body-medium-strong">{program.speaker.name}</span>
          </div>
          {
            program.speaker.xUrl && (
              <a
                href={program.speaker.xUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label={`X Link`}
              >
                <XLogo />
              </a>
            )
          }
        </div>
        {
          program.speaker.company && (
            <div class="company-name text-body-small-strong">
              <p>{program.speaker.company}</p>
            </div>
          )
        }
        {
          program.speaker.description && (
            <div class="text-body-medium">
              <p>{program.speaker.description}</p>
            </div>
          )
        }
      </section>

      <div class="share-action">
        <Button variant="secondary" size="large" href={shareUrl} isBlankLink>
          {shareLabel}
        </Button>
      </div>
    </div>

    {
      connpassUrl && (
        <div class="floating-register-column">
          <div class="floating-register-sticky">
            <div class="floating-register">
              <Button
                variant="primary"
                size="large"
                href={connpassUrl}
                isBlankLink
              >
                {registerLabel}
              </Button>
            </div>
          </div>
        </div>
      )
    }
  </div>
</SubPage>

<style>
  .detail--with-fab {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .detail--with-fab .detail-body,
  .detail--with-fab .floating-register-column {
    grid-row: 1;
    grid-column: 1;
  }

  .detail--with-fab .detail-body {
    padding-bottom: 27px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .section-title {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .section-title::first-letter {
    color: var(--text-accent);
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xxs);
    color: var(--text-on-fill);
  }

  .badges {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xxs);
  }

  .room-badge {
    display: flex;
    align-items: center;
    gap: var(--space-xxs);
    padding: var(--space-xxxs) var(--space-s) var(--space-xxxs) var(--space-xs);
    border-radius: var(--radius-objects);
  }

  .room-badge--longSession,
  .room-badge--shortTalk,
  .room-badge--sponsorSession,
  .room-badge--keynote {
    background-color: var(--surface-session);
  }

  .room-badge .room-icon {
    fill: var(--text-on-fill);
    size: 24px;
  }

  .room-badge--workshop {
    background-color: var(--surface-workshop);
  }

  .sponsored-session-badge {
    background-color: var(--text-secondary);
    padding: var(--space-xxxs) var(--space-xs);
    border-radius: var(--radius-objects);
    display: flex;
  }

  .sponsored-session-badge span {
    margin-top: -2px;
  }

  .session-type-label {
    color: var(--text-accent);
  }

  section#content {
    margin-bottom: var(--space-m);
  }

  section#content .description {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  section#speaker {
    display: flex;
    flex-direction: column;
    background-color: var(--surface-primary);
    border: 2px solid var(--surface-disabled);
    border-radius: var(--radius-objects);
    gap: 8px;
    padding: var(--space-m);
    overflow-wrap: anywhere;
  }

  section#speaker p {
    margin: 0;
  }

  section#speaker .speaker-info {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-xs);
  }

  section#speaker .speaker-info-name {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-xxs);
  }

  section#speaker .speaker-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  section#speaker .social-link {
    display: flex;
    width: 30px;
    height: 30px;
  }

  section#speaker .company-name {
    color: var(--text-secondary);
  }

  .share-action {
    margin-top: var(--space-xs);
    width: fit-content;
    max-width: 100%;
  }

  .share-action :global(a) {
    width: auto;
    max-width: 100%;
    display: block;
  }

  .share-action :global(.c-button) {
    width: auto;
    max-width: 100%;
    /* large の縦余白より画像に合わせて詰める（変数指定だと data-size に負ける） */
    padding: calc(var(--space-xxxs) - 2px) var(--space-s);
    white-space: nowrap;
  }

  .floating-register-column {
    pointer-events: none;
    z-index: 100;
  }

  .floating-register-sticky {
    position: sticky;
    /* 画面下端付近に固定し、コンテンツ末尾（footer-visual 手前）で解除 */
    top: calc(100vh - 6rem);
    top: calc(100dvh - 6rem);
    display: flex;
    justify-content: flex-end;
    max-width: 100%;
    box-sizing: border-box;
  }

  .floating-register {
    pointer-events: auto;
    width: fit-content;
    max-width: 100%;
  }

  .floating-register :global(a) {
    width: auto;
    max-width: 100%;
    display: block;
  }

  .floating-register :global(.c-button) {
    width: auto;
    max-width: 100%;
    padding-inline: var(--space-s);
    box-shadow: 0 4px 16px rgb(0 0 0 / 16%);
    white-space: nowrap;
  }

  @media screen and (max-width: 768px) {
    .detail--with-fab .detail-body {
      padding-bottom: 100px;
    }

    .floating-register-sticky {
      top: calc(100vh - 4.5rem);
      top: calc(100dvh - 4.5rem);
    }

    .floating-register :global(.c-button) {
      font-size: clamp(17px, 14.857px + 0.67vw, 20px);
      box-shadow: 0 2px 8px rgb(0 0 0 / 14%);
    }
  }
</style>
